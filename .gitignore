# Code-only release: allow source, installation metadata and user instructions.
*
!*/
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/paper_2/**/*.py
!/paper_2/pyproject.toml
!/paper_2/README.md
!/paper_2/THIRD_PARTY_NOTICES.md
!/paper_2/work2/vendor/DADP_official/LICENCE.txt
!/paper_2/work2/configs/*.json
!/paper_2/work2/collection/recipe.json
!/paper_2/work2/required_assets.json
!/paper_3/**/*.py
!/paper_3/README.md
!/paper_3/requirements.txt
!/paper_3/BSM2_LICENSE
!/paper_3/configs/*.json
!/reproduction/figures/**/*.py
!/reproduction/figures/README.md
!/reproduction/figures/requirements.txt

# Generated inputs, models, outputs and local environments stay untracked.
.venv*/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
inputs/
data/
datasets/
models/
checkpoints/
